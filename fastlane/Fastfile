default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: "V8DCBT64PJ",
    issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
    key_filepath: File.join(__dir__, "AuthKey_V8DCBT64PJ.p8"),
    duration: 1200,
    in_house: false
  )
end

platform :ios do

  desc "Uploade les metadonnees seulement (textes FR/EN sans vocabulaire therapeutique)"
  lane :upload_meta do
