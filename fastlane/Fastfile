      app_identifier: "com.unautreregard.app.en",
      submit_for_review: false,
      automatic_release: false,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Uploade tout (textes + captures), sans soumettre"
  lane :upload_all do
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.unautreregard.app.en",
      submit_for_review: false,
      automatic_release: false,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Soumet la version a la review Apple"
  lane :submit do
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.unautreregard.app.en",
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_available_on_french_store: true,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      },
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  # ============================================================
  # Lane : remove_locale
  # Supprime une localisation (version + app info) de la fiche.
  # Usage : fastlane remove_locale locale:fr-FR
  # ============================================================
  desc "Supprime une localisation de la fiche (texte version + texte app info)"
  lane :remove_locale do |options|
    locale = options[:locale] || "fr-FR"
    require "spaceship"
    key_path = File.join(__dir__, "AuthKey_V8DCBT64PJ.p8")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "V8DCBT64PJ",
      issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
      filepath: key_path
    )

    app = Spaceship::ConnectAPI::App.find("com.unautreregard.app.en")
    UI.user_error!("App com.unautreregard.app.en introuvable") unless app

    # 1. Localisation de la version en preparation
    version = app.get_edit_app_store_version
    if version
      version_locs = version.get_app_store_version_localizations
      target = version_locs.find { |l| l.locale == locale }
      if target
        target.delete!
        UI.success("Localisation version #{locale} supprimee")
      else
        UI.message("Localisation version #{locale} deja absente")
      end
    else
      UI.message("Pas de version editable")
    end

    # 2. Localisation de l'app info (le bloc Informations sur l'app)
    edit_info = app.fetch_edit_app_info
    if edit_info
      info_locs = edit_info.get_app_info_localizations
      found = info_locs.find { |l| l.locale == locale }
      if found
        found.delete!
        UI.success("Localisation app info (edit) #{locale} supprimee")
      else
        UI.message("Localisation app info (edit) #{locale} deja absente")
      end
    end

    # 3. Localisation de l'app info LIVE (si app deja publiee)
    live_info = app.fetch_live_app_info
    if live_info
      info_locs = live_info.get_app_info_localizations
      found = info_locs.find { |l| l.locale == locale }
      if found
        found.delete!
        UI.success("Localisation app info (live) #{locale} supprimee")
      end
    end
  end

  # ============================================================
  # Lane : cm_list_apps
  # Liste les apps Codemagic accessibles avec leur API token.
  # Sert a recuperer l'appId et workflowId a configurer.
  # Pre-requis : variable d'env CODEMAGIC_API_TOKEN
  # Usage : fastlane cm_list_apps
  # ============================================================
  desc "Liste les apps Codemagic accessibles via l'API token"
  lane :cm_list_apps do
    require "net/http"
    require "json"

    token = ENV["CODEMAGIC_API_TOKEN"]
    UI.user_error!("CODEMAGIC_API_TOKEN manquant. Cree-en un sur https://codemagic.io/teams (User settings > Integrations > API tokens), puis dans PowerShell : $env:CODEMAGIC_API_TOKEN='xxx'") if token.nil? || token.empty?

    uri = URI("https://api.codemagic.io/apps")
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = true
    req = Net::HTTP::Get.new(uri.path)
    req["x-auth-token"] = token

    resp = http.request(req)
    UI.user_error!("Codemagic API a repondu #{resp.code} : #{resp.body}") unless resp.code.to_i.between?(200, 299)

    data = JSON.parse(resp.body)
    apps = data["applications"] || data
    UI.message("====== APPS CODEMAGIC ======")
    apps.each do |app|
      UI.message("  #{app['appName']}")
      UI.message("    _id           : #{app['_id']}")
      UI.message("    repository    : #{app.dig('repository', 'htmlUrl') || app.dig('repository', 'gitUrl')}")
      workflows = app["workflows"] || {}
      if workflows.is_a?(Hash)
        workflows.each do |wf_id, wf|
          name = wf.is_a?(Hash) ? (wf["name"] || wf_id) : wf_id
          UI.message("    workflow      : #{wf_id}  (#{name})")
        end
      end
      UI.message("")
    end
    UI.success("============================")
  end

  # ============================================================
  # Lane : cm_build
  # Declenche un build Codemagic via API.
  # Pre-requis ENV : CODEMAGIC_API_TOKEN, CODEMAGIC_APP_ID
  # Optionnel ENV : CODEMAGIC_WORKFLOW_ID (sinon "default-workflow")
  # Usage : fastlane cm_build              (branche par defaut : main)
  #         fastlane cm_build branch:dev   (autre branche)
  # ============================================================
  desc "Declenche un build Codemagic via API (auto-merge metadata sans saisie UI)"
  lane :cm_build do |options|
    require "net/http"
    require "json"

    token = ENV["CODEMAGIC_API_TOKEN"]
    UI.user_error!("CODEMAGIC_API_TOKEN manquant") if token.nil? || token.empty?

    app_id = options[:app_id] || ENV["CODEMAGIC_APP_ID"]
    UI.user_error!("CODEMAGIC_APP_ID manquant (env var ou param app_id:xxx)") if app_id.nil? || app_id.empty?

    workflow_id = options[:workflow_id] || ENV["CODEMAGIC_WORKFLOW_ID"] || "default-workflow"
    branch = options[:branch] || "main"

    uri = URI("https://api.codemagic.io/builds")
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = true
    req = Net::HTTP::Post.new(uri.path)
    req["Content-Type"] = "application/json"
    req["x-auth-token"] = token
    req.body = {
      appId: app_id,
      workflowId: workflow_id,
      branch: branch
    }.to_json

    UI.message("Declenche build Codemagic : app=#{app_id}, workflow=#{workflow_id}, branche=#{branch}")
    resp = http.request(req)

    if resp.code.to_i.between?(200, 299)
      body = JSON.parse(resp.body)
      build_id = body["buildId"]
      UI.success("Build declenche : buildId=#{build_id}")
      UI.success("Suivi : https://codemagic.io/app/#{app_id}/build/#{build_id}")
    else
      UI.error("Codemagic a repondu #{resp.code}")
      UI.error(resp.body.to_s)
      UI.user_error!("Echec du declenchement Codemagic")
    end
  end

  # ============================================================
  # Lane : cancel_pending
  # Annule la submission en cours (si elle existe) pour permettre
  # de soumettre une nouvelle version. Necessaire quand Apple
  # repond "A review submission is already in progress".
  # Usage : fastlane cancel_pending
  # ============================================================
  desc "Annule la submission en cours (state non terminal)"
  lane :cancel_pending do
    require "spaceship"
    key_path = File.join(__dir__, "AuthKey_V8DCBT64PJ.p8")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "V8DCBT64PJ",
      issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
      filepath: key_path
    )

    app = Spaceship::ConnectAPI::App.find("com.unautreregard.app.en")
    UI.user_error!("App com.unautreregard.app.en introuvable") unless app

    in_progress = app.get_in_progress_review_submission(platform: "IOS")

    if in_progress.nil?
      UI.message("Aucune submission en cours, rien a annuler")
    else
      UI.message("Submission en cours : id=#{in_progress.id}, state=#{in_progress.state}")
      # Tentative 1 : cancel_submission (API Spaceship recente)
      begin
        in_progress.cancel_submission
        UI.success("Submission #{in_progress.id} annulee via cancel_submission")
      rescue NoMethodError, StandardError => e
        UI.message("cancel_submission a echoue (#{e.message}), tentative via suppression des items...")
        # Tentative 2 : supprimer les ReviewSubmissionItems
        items = in_progress.review_submission_items rescue nil
        if items && !items.empty?
          items.each do |item|
            begin
              item.delete!
              UI.success("Item de submission supprime : #{item.id}")
            rescue => err
              UI.error("Erreur suppression item #{item.id} : #{err.message}")
            end
          end
        else
          UI.error("Impossible de recuperer ou supprimer les items, l'API a renvoye une erreur. Voir ci-dessus.")
        end
      end
    end
  end

  # ============================================================
  # Lane : show_meta
  # Affiche la description ACTUELLEMENT en ligne sur App Store Connect
  # (version editable + version live) pour comparer avec le local et
  # detecter un desync (metadata locale jamais uploadee).
  # Usage : fastlane show_meta
  # ============================================================
  desc "Affiche la description en ligne sur ASC (edit + live) pour detecter un desync"
  lane :show_meta do
    require "spaceship"
    key_path = File.join(__dir__, "AuthKey_V8DCBT64PJ.p8")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "V8DCBT64PJ",
      issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
      filepath: key_path
    )
    app = Spaceship::ConnectAPI::App.find("com.unautreregard.app.en")
    UI.user_error!("App introuvable") unless app

    edit = app.get_edit_app_store_version
    if edit
      loc = edit.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
      UI.message("===== VERSION EDITABLE (#{edit.version_string} / #{edit.app_store_state}) =====")
      UI.message("DESC (300 premiers car.):\n#{(loc&.description || '(vide)')[0,300]}")
    else
      UI.message("Aucune version editable.")
    end

    live = app.get_live_app_store_version rescue nil
    if live
      loc = live.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
      UI.message("===== VERSION LIVE (#{live.version_string}) =====")
      UI.message("DESC (300 premiers car.):\n#{(loc&.description || '(vide)')[0,300]}")
    end
  end

  # ============================================================
  # Lane : resubmit46
  # Annule une submission en cours, attache le build 46 a la version
  # editable, puis soumet a la review (declarations legales incluses).
  # Usage : fastlane resubmit46
  # ============================================================
  desc "Attache le build 46 a la version et soumet a la review"
  lane :resubmit46 do
    require "spaceship"
    key_path = File.join(__dir__, "AuthKey_V8DCBT64PJ.p8")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "V8DCBT64PJ",
      issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
      filepath: key_path
    )
    app = Spaceship::ConnectAPI::App.find("com.unautreregard.app.en")
    UI.user_error!("App introuvable") unless app

    # 1. Annuler une eventuelle submission en cours
    ip = app.get_in_progress_review_submission(platform: "IOS") rescue nil
    if ip
      UI.message("Submission en cours #{ip.id} (#{ip.state}) -> annulation")
      begin
        ip.cancel_submission
      rescue => e
        UI.error("cancel echoue: #{e.message}")
      end
    else
      UI.message("Aucune submission en cours a annuler")
    end

    # 2. Attacher le build 46 a la version editable
    version = app.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("Pas de version editable") unless version
    UI.message("Version editable #{version.version_string} state=#{version.app_store_state}")
    builds = app.get_builds(includes: "preReleaseVersion", sort: "-uploadedDate", limit: 30)
    b46 = builds.find { |b| b.version == "46" && b.pre_release_version&.version == version.version_string }
    b46 ||= builds.find { |b| b.version == "46" }
    UI.user_error!("Build 46 introuvable sur TestFlight") unless b46
    UI.message("Attache build 46 (id=#{b46.id}) a la version...")
    version.select_build(build_id: b46.id)
    UI.success("Build 46 attache.")

    # 3. Soumettre a la review
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.unautreregard.app.en",
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_available_on_french_store: true,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      },
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  # ============================================================
  # Lane : submit_sp
  # Soumission 100% Spaceship (contourne deliver qui echoue en
  # "Authentication credentials missing or invalid" sur ce poste).
  # Annule les submissions ouvertes, attache le build 46, pose les
  # declarations legales (chiffrement non exempt = non, droits de
  # contenu tiers = oui), cree une reviewSubmission moderne et soumet.
  # Pre-requis : metadata deja a jour sur ASC (upload_meta du 02/06).
  # Usage : fastlane submit_sp
  # ============================================================
  desc "Soumet a la review via Spaceship (attache build 46 + declarations legales)"
  lane :submit_sp do
    require "spaceship"
    key_path = File.join(__dir__, "AuthKey_V8DCBT64PJ.p8")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "V8DCBT64PJ",
      issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
      filepath: key_path
    )
    app = Spaceship::ConnectAPI::App.find("com.unautreregard.app.en")
    UI.user_error!("App introuvable") unless app
    req = Spaceship::ConnectAPI.client.tunes_request_client

    open_states = %w[READY_FOR_REVIEW WAITING_FOR_REVIEW IN_REVIEW UNRESOLVED_ISSUES CANCELING]

    # 1. Annuler toutes les submissions ouvertes
    resp = req.get("v1/apps/#{app.id}/reviewSubmissions", { "filter[platform]" => "IOS" })
    (resp.body["data"] || []).each do |s|
      st = s.dig("attributes", "state")
      next unless open_states.include?(st)
      UI.message("Annulation de #{s['id']} (etat=#{st})...")
      begin
        req.patch("v1/reviewSubmissions/#{s['id']}", {
          "data" => { "type" => "reviewSubmissions", "id" => s['id'],
                      "attributes" => { "canceled" => true } }
        })
      rescue => e
        UI.error("  echec annulation: #{e.message}")
      end
    end

    # 2. Attendre qu'il n'y ait plus de submission ouverte
    cleared = false
    20.times do
      r = req.get("v1/apps/#{app.id}/reviewSubmissions", { "filter[platform]" => "IOS" })
      still_open = (r.body["data"] || []).any? { |s| open_states.include?(s.dig("attributes", "state")) }
      unless still_open
        cleared = true
        break
      end
      sleep 6
    end
    UI.message(cleared ? "Plus aucune submission ouverte." : "ATTENTION: une submission semble encore ouverte.")

    # 3. Version editable prete
    version = app.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("Pas de version editable") unless version
    UI.message("Version a soumettre: #{version.version_string} (#{version.app_store_state}) id=#{version.id}")

    # 4. Attacher le build 46
    builds = app.get_builds(includes: "preReleaseVersion", sort: "-uploadedDate", limit: 30)
    b46 = builds.find { |b| b.version == "46" && b.pre_release_version&.version == version.version_string }
    b46 ||= builds.find { |b| b.version == "46" }
    UI.user_error!("Build 46 introuvable sur TestFlight") unless b46
    UI.message("Attache build 46 (id=#{b46.id})...")
    version.select_build(build_id: b46.id)

    # 5. Declaration de chiffrement non exempt = non
    begin
      req.patch("v1/builds/#{b46.id}", {
        "data" => { "type" => "builds", "id" => b46.id,
                    "attributes" => { "usesNonExemptEncryption" => false } }
      })
      UI.message("Chiffrement non exempt = false pose sur build 46.")
    rescue => e
      UI.error("  declaration chiffrement: #{e.message}")
    end

    # 6. Droits de contenu tiers = oui (l'app cite des references publiees)
    begin
      req.patch("v1/apps/#{app.id}", {
        "data" => { "type" => "apps", "id" => app.id,
                    "attributes" => { "contentRightsDeclaration" => "USES_THIRD_PARTY_CONTENT" } }
      })
      UI.message("Droits de contenu tiers = USES_THIRD_PARTY_CONTENT.")
    rescue => e
      UI.error("  declaration droits de contenu: #{e.message}")
    end

    # 7. Creer une nouvelle reviewSubmission
    cresp = req.post("v1/reviewSubmissions", {
      "data" => {
        "type" => "reviewSubmissions",
        "attributes" => { "platform" => "IOS" },
        "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app.id } } }
      }
    })
    new_sub_id = cresp.body.dig("data", "id")
    UI.user_error!("Creation submission echouee") unless new_sub_id
    UI.message("Nouvelle submission creee: #{new_sub_id}")

    # 8. Attacher la version comme item
    req.post("v1/reviewSubmissionItems", {
      "data" => {
        "type" => "reviewSubmissionItems",
        "relationships" => {
          "reviewSubmission" => { "data" => { "type" => "reviewSubmissions", "id" => new_sub_id } },
          "appStoreVersion" => { "data" => { "type" => "appStoreVersions", "id" => version.id } }
        }
      }
    })
    UI.message("Version attachee a la submission.")

    # 9. Soumettre
    psresp = req.patch("v1/reviewSubmissions/#{new_sub_id}", {
      "data" => { "type" => "reviewSubmissions", "id" => new_sub_id,
                  "attributes" => { "submitted" => true } }
    })
    final_state = psresp.body.dig("data", "attributes", "state")
    UI.success("SOUMIS A LA REVIEW — HTTP #{psresp.status} — etat=#{final_state}")
  end

  desc "Liste les builds TestFlight disponibles"
  lane :list_builds do
    require "spaceship"
    key_path = File.join(__dir__, "AuthKey_V8DCBT64PJ.p8")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "V8DCBT64PJ",
      issuer_id: "62613a44-8050-4453-95ca-bcb8a0dcd21e",
      filepath: key_path
    )

    app = Spaceship::ConnectAPI::App.find("com.unautreregard.app.en")
    UI.user_error!("App com.unautreregard.app.en introuvable") unless app

    builds = app.get_builds(includes: "preReleaseVersion",
                            sort: "-uploadedDate",
                            limit: 20)

    UI.message("====== BUILDS TESTFLIGHT — An Other Perspective ======")
    builds.each do |b|
      ver = b.pre_release_version&.version || "?"
      UI.message("  version=#{ver}  build=#{b.version}  state=#{b.processing_state}  uploaded=#{b.uploaded_date}")
    end
    UI.success("======================================================")
  end

end
